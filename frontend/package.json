{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "api:convert": "swagger2openapi ../docs/swagger.json -o ./lib/api/openapi.json",
    "api:types": "openapi-typescript ./lib/api/openapi.json -o ./lib/api/schema.d.ts",
    "api:gen": "npm run api:convert && npm run api:types",
    "dev": "next dev",
    "start": "next start",
    "build": "next build",
    "lint": "next lint"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "openapi-typescript": "^7.13.0",
    "swagger2openapi": "^7.0.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
